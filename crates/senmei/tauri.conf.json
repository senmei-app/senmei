{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Senmei",
  "version": "0.1.0",
  "identifier": "app.senmei.desktop",
  "build": {
    "beforeDevCommand": "cd packages/app && bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "cd packages/app && bun run build",
    "frontendDist": "../../packages/app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Senmei",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$DATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "resources": ["../../models/metadata.json"]
  }
}
