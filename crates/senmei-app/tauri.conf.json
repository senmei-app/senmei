{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Senmei",
  "version": "0.1.0",
  "identifier": "app.senmei.desktop",
  "build": {
    "beforeDevCommand": "cd ../../packages/app && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cd ../../packages/app && bun run build",
    "frontendDist": "../../packages/app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Senmei",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  }
}
