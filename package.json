{
  "name": "senmei",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "predev": "bun run dev:clean",
    "predev:release": "bun run dev:clean",
    "dev": "cargo tauri dev",
    "dev:release": "cargo tauri dev --release",
    "ui:dev": "cd packages/app && bun run dev",
    "build": "cd packages/app && bun run build",
    "deny": "cargo-deny check",
    "dev:clean": "bun tools/dev-clean.ts",
    "postinstall": "bun tools/ensure-tauri-cli.ts"
  }
}
